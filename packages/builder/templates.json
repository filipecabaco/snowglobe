        "static-preview",
        "agent-skills",
        "source-export"
      ],
      "devDependencies": {
        "vite": "8.3.6",
        "typescript": "5.9.3",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "svelte-check": "4.7.8"
      },
      "dependencies": {
        "svelte": "5.57.3"
      },
      "scripts": {
        "build": "vite",
        "check": "svelte-check"
      },
      "id": "svelte-vite",
      "displayName": "Svelte + Vite",
      "status": "verified-development",
      "entry": "src/App.svelte",
      "files": {
        "index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>My Snowglobe app</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"/src/main.js\"></script></body></html>\n",
        "src/main.js": "import {mount} from 'svelte';\nimport App from './App.svelte';\nimport './style.css';\nmount(App,{target:document.getElementById('app')});\n",
        "src/App.svelte": "<script>let count=$state(0);</script>\n<main><h1>A little idea. A real app.</h1><p>Built with Svelte in your browser VM.</p><button onclick={()=>count++}>Count: {count}</button></main>\n",
        "src/style.css": "body{margin:0;background:#f6f8f3;color:#1d392b;font:16px system-ui}main{max-width:720px;margin:8vh auto;padding:36px}button{padding:12px 20px;background:#245d48;color:white;border:0;border-radius:9px;font:inherit;cursor:pointer}",
        "vite.config.js": "import {svelte} from '@sveltejs/vite-plugin-svelte';\nexport default {base:'./',plugins:[svelte()]};\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"allowJs\": true,\n    \"checkJs\": false,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\n      \"vite/client\"\n    ]\n  },\n  \"include\": [\n    \"src\"\n  ]\n}\n"
      }
    },
