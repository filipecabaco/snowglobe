      "id": "sveltekit-spa",
      "displayName": "SvelteKit SPA",
      "status": "verified-development",
      "entry": "src/routes/+page.svelte",
      "files": {
        "src/routes/+page.svelte": "<script>let count=$state(0);</script>\n<main><h1>A little idea. A real app.</h1><button onclick={()=>count++}>Count: {count}</button><a href=\"#/about\">About this app</a></main>\n<style>main{font-family:system-ui;padding:40px}button{padding:12px;background:#245d48;color:white}</style>\n",
        "src/app.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">%sveltekit.head%</head><body><div style=\"display:contents\">%sveltekit.body%</div></body></html>\n",
        "vite.config.js": "import {sveltekit} from '@sveltejs/kit/vite';\nimport adapter from '@sveltejs/adapter-static';\nexport default {plugins:[sveltekit({adapter:adapter({fallback:'index.html',strict:false}),router:{type:'hash'},paths:{relative:false}})],build:{modulePreload:false,reportCompressedSize:false}};\n",
        "tsconfig.json": "{\n  \"extends\": \"$app/tsconfig\",\n  \"include\": [\n    \"src\",\n    \"test\",\n    \"*\"\n  ],\n  \"exclude\": [\n    \"src/service-worker\"\n  ],\n  \"compilerOptions\": {\n    \"allowJs\": true,\n    \"checkJs\": false,\n    \"strict\": true,\n    \"moduleResolution\": \"bundler\"\n  }\n}\n",
        "src/routes/about/+page.svelte": "<h1>About this SvelteKit app</h1><a href=\"#/\">Home</a>\n"
      }
    }
