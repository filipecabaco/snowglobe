<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Not here · snowglobe</title>
  <meta name="robots" content="noindex">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230d0d0d'/%3E%3Ccircle cx='8' cy='8' r='3.2' fill='%23d6300c'/%3E%3C/svg%3E">
  <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/base.css">
  <script>
    // Apply a remembered theme before first paint, so the page never flashes the wrong one
    try { const t = localStorage.getItem("snowglobe-theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <div class="wrap">
<%= Site.Templates.header(current: nil, links: Site.links()) %>
    <main>
      <section class="hero">
        <h1>Nothing is here.</h1>
        <p class="lede">This address isn't one of snowglobe's pages. The <a href="/#runs">runs</a>, the
          <a href="/docs/">docs</a> and the <a href="/agent/">agent page</a> are.</p>
      </section>
    </main>

<%= Site.Templates.footer(credits: false, back: true) %>
  </div>

  <script src="/theme.js"></script>
</body>
</html>
