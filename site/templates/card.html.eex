<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- /card/<dir>/: one per demo in site/cards.json -->
  <title><%= Site.h(@card["name"]) %>, sandboxed in your browser · snowglobe</title>
  <meta name="description" content="<%= Site.h(@card["about"]) %>: Linux on a 64-bit ARM machine emulated in WebAssembly, right in your browser. No server.">
  <!-- An X player card: X loads twitter:player in an iframe inside the post. The crawler reads
       these tags from static HTML, and every URL must be absolute https -->
  <meta name="twitter:card" content="player">
  <meta name="twitter:title" content="<%= Site.h(@card["name"]) %>, sandboxed in your browser">
  <meta name="twitter:description" content="<%= Site.h(@card["about"]) %>: Linux on a 64-bit ARM machine emulated in WebAssembly. Tap to boot it. No server.">
  <meta name="twitter:image" content="<%= @site %>/card/<%= @card["dir"] %>/poster.png">
  <meta name="twitter:image:alt" content="<%= Site.h(@card["name"]) %>: real output recorded from this run">
  <meta name="twitter:player" content="<%= @site %>/<%= @card["player"] || @card["dir"] %>/?embed">
  <meta name="twitter:player:width" content="480">
  <meta name="twitter:player:height" content="480">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="snowglobe">
  <meta property="og:title" content="<%= Site.h(@card["name"]) %>, sandboxed in your browser">
  <meta property="og:description" content="<%= Site.h(@card["about"]) %>: Linux on a 64-bit ARM machine emulated in WebAssembly. No server.">
  <meta property="og:image" content="<%= @site %>/card/<%= @card["dir"] %>/poster.png">
  <meta property="og:url" content="<%= @site %>/card/<%= @card["dir"] %>/">
  <link rel="canonical" href="<%= @site %>/#<%= @card["dir"] %>">
  <style>
    body { margin: 0; padding: 32px 20px; background: #0d0d0c; color: #ecece8; font: 16px/1.5 system-ui, sans-serif; }
    a { color: inherit; }
  </style>
</head>
<body>
  <!-- People who open the link itself (not the card) go to the run on the demo page -->
  <p>Opening the <%= Site.h(@card["name"]) %> run… <a href="/#<%= @card["dir"] %>">Continue to snowglobe</a></p>
  <script>location.replace("/#<%= @card["dir"] %>");</script>
</body>
</html>
