    <header class="top">
      <a class="mark" href="/">snowglobe<i aria-hidden="true"></i></a>
      <nav aria-label="Site">
<%= for {href, label} <- @links do %>        <a href="<%= href %>"<%= if href == @current do %> aria-current="page"<% end %>><%= label %></a>
<% end %>        <a href="https://github.com/filipecabaco/snowglobe">GitHub</a>
        <button class="theme" type="button" id="theme-toggle" aria-label="Switch to dark theme">Dark</button>
      </nav>
    </header>
